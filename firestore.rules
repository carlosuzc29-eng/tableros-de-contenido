rules_version = '2';

// ===============================================================
// Nexo Agencia Creativa · Reglas de Seguridad Cloud Firestore
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: usuario autenticado del equipo (Nexo: Carlos y Andrea)
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email in ['carlosuzc29@gmail.com', 'andrevmuedit@gmail.com'];
    }

    // Helper: validar que el id termine en un código aleatorio hexadecimal de 6 a 8 caracteres
    function hasValidRandomSuffix(docId) {
      return docId.matches('.*-[0-9a-f]{6,8}$');
    }

    // Colección principal de tableros de contenido (aprobaciones)
    match /tableros/{tableroId} {
      allow list: if isAuthenticated();
      allow get: if true;
      allow delete: if isAuthenticated();

      // Autorregistro sin sesión o creación por equipo autenticado
      allow create: if isAuthenticated() || (
        request.resource.data.id == tableroId &&
        hasValidRandomSuffix(tableroId) &&
        request.resource.data.keys().hasOnly([
          'id', 'cliente', 'mes', 'anio', 'url', 'total', 'aprobados', 'cambios', 'pendientes', 'estado', 'revisadoPor', 'ultimaRevision', 'registrado', 'contenidos'
        ]) &&
        request.resource.data.estado == 'Sin revisar' &&
        request.resource.data.aprobados == 0 &&
        request.resource.data.cambios == 0 &&
        request.resource.data.pendientes == request.resource.data.total &&
        request.resource.data.revisadoPor == '' &&
        request.resource.data.contenidos.size() == 0
      );

      // Actualización: equipo autenticado o cliente enviando su revisión
      allow update: if isAuthenticated() || (
        request.resource.data.id == resource.data.id &&
        request.resource.data.cliente == resource.data.cliente &&
        request.resource.data.url == resource.data.url &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aprobados', 'cambios', 'pendientes', 'estado', 'revisadoPor', 'ultimaRevision', 'contenidos'
        ])
      );

      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Colección de tableros de producción en vivo (rodajes)
    match /produccion/{prodId} {
      allow list: if isAuthenticated();
      allow get: if true;
      allow delete: if isAuthenticated();

      // Autorregistro sin sesión o creación por equipo autenticado
      allow create: if isAuthenticated() || (
        request.resource.data.id == prodId &&
        hasValidRandomSuffix(prodId) &&
        request.resource.data.keys().hasOnly([
          'id', 'cliente', 'fecha', 'url', 'registrado', 'orden', 'tarjetas', 'todo', 'grabando', 'listo', 'actualizado'
        ]) &&
        request.resource.data.todo == request.resource.data.orden.size() &&
        request.resource.data.grabando == 0 &&
        request.resource.data.listo == 0
      );

      // Actualización: equipo autenticado o usuario moviendo tarjetas en rodaje
      allow update: if isAuthenticated() || (
        request.resource.data.id == resource.data.id &&
        request.resource.data.cliente == resource.data.cliente &&
        request.resource.data.fecha == resource.data.fecha &&
        request.resource.data.url == resource.data.url &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tarjetas', 'orden', 'todo', 'grabando', 'listo', 'actualizado'
        ])
      );
    }

    // Colección de informes de rendimiento y analítica
    match /informes/{informeId} {
      allow list: if isAuthenticated();
      allow get: if true;
      allow delete: if isAuthenticated();
      allow update: if isAuthenticated();

      // Autorregistro sin sesión o creación por equipo autenticado
      allow create: if isAuthenticated() || (
        request.resource.data.id == informeId &&
        hasValidRandomSuffix(informeId) &&
        request.resource.data.keys().hasOnly([
          'id', 'tipo', 'cliente', 'periodo', 'url', 'registrado'
        ]) &&
        request.resource.data.tipo in ['gestion', 'meta-ads'] &&
        request.resource.data.periodo.matches('^[0-9]{4}-[0-9]{2}$')
      );
    }
  }
}
